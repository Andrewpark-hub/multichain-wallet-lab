# 테스트넷 전용 니모닉만 사용할 것. 실자산이 들어있는 니모닉은 절대 넣지 않는다.
MNEMONIC=

# 기본값은 dry-run(서명까지만)이다.
# 실제로 네트워크에 보내려면 명령 앞에 SEND_TX=true 를 붙인다.
# SEND_TX=true

# RPC 주소 (비워두면 각 스크립트의 기본 공개 RPC를 사용한다)
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# 전송 / 승인 파라미터
# TO_ADDRESS=0x...
# ETH_AMOUNT=0.001
# SPENDER_ADDRESS=0x...
# TOKEN_AMOUNT=1

# 감사 파라미터
# OWNER_ADDRESS=0x...        # 남의 주소를 읽기 전용으로 감사할 때
# LOOKBACK_BLOCKS=100000     # 몇 블록 전까지 로그를 볼 것인가
# LOG_CHUNK=9000             # 한 번에 조회할 블록 범위
